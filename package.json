{
  "name": "ghostwriter",
  "version": "0.1.0",
  "private": true,
  "description": "Agent skill for writing and editing technical text: cuts filler, replaces judgments with facts, keeps the author's voice",
  "keywords": [
    "agent-skills",
    "claude-code",
    "copyediting",
    "plain-language",
    "prose",
    "readability",
    "technical-writing",
    "writing"
  ],
  "homepage": "https://github.com/azat-io/ghostwriter",
  "repository": "azat-io/ghostwriter",
  "license": "MIT",
  "author": "Azat S. <to@azat.io>",
  "type": "module",
  "scripts": {
    "eval": "node scripts/run-evaluations.js",
    "release": "pnpm release:check && pnpm release:version && pnpm release:prepare && pnpm release:git",
    "release:check": "pnpm test",
    "release:git": "pnpm release:git:add && pnpm release:git:commit && pnpm release:git:tag && pnpm release:git:push",
    "release:git:add": "git add .",
    "release:git:commit": "cross-env-shell \"git commit -m \\\"build: publish v$npm_package_version\\\"\"",
    "release:git:push": "cross-env-shell \"git push --atomic origin HEAD v$npm_package_version\"",
    "release:git:tag": "cross-env-shell \"git tag v$npm_package_version\"",
    "release:prepare": "pnpm run /^release:prepare:/",
    "release:prepare:changelog": "prettier --write changelog.md",
    "release:prepare:package-json": "prettier --write package.json",
    "release:version": "changelogen --output changelog.md --release --no-commit --no-tag",
    "test": "pnpm run /^test:/",
    "test:fixtures": "node scripts/check-fixtures.js",
    "test:format": "prettier --check \"**/*.{js,ts,json,md,yml}\" --ignore-path .gitignore --ignore-path test/fixtures/.prettierignore",
    "test:js": "eslint .",
    "test:packages": "pnpm dedupe --check",
    "test:skill": "node scripts/check-skill.js",
    "test:spelling": "cspell --config cspell.config.js \"**/*\"",
    "test:unit": "vitest --run --coverage"
  },
  "devDependencies": {
    "@azat-io/eslint-config": "^2.101.0",
    "@azat-io/prettier-config": "^1.3.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@vitest/coverage-v8": "^5.0.5",
    "changelogen": "^0.6.2",
    "changelogithub": "^15.0.5",
    "cross-env": "^10.1.0",
    "cspell": "^10.4.0",
    "entities": "^8.1.0",
    "eslint": "^10.13.0",
    "github-slugger": "^2.0.0",
    "marked": "^18.1.2",
    "prettier": "^3.9.10",
    "simple-git-hooks": "^2.14.0",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": "^22.22.3 || ^24.16.0 || >=26.3.0"
  }
}
